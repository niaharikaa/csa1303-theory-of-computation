/* CFG membership check
       S -> 0S0 | A
       A -> 1A | epsilon
   Language: { 0^n 1^m 0^n | n >= 0, m >= 0 }
   S peels a matching 0 from both ends; what remains must be derivable from A
   (zero or more 1s). */
#include <stdio.h>
#include <string.h>

int A(const char *in, int lo, int hi) {
    for (int i = lo; i <= hi; i++)               /* A -> 1A ... A -> epsilon */
        if (in[i] != '1') return 0;
    return 1;
}

int S(const char *in, int lo, int hi) {
    if (lo < hi && in[lo] == '0' && in[hi] == '0' && S(in, lo + 1, hi - 1))
        return 1;                                /* S -> 0S0 */
    return A(in, lo, hi);                        /* S -> A   */
}

int main(void) {
    char str[1000] = "";
    printf("Enter a string over {0,1} (press Enter alone for empty string): ");
    if (!fgets(str, sizeof str, stdin)) return 1;
    str[strcspn(str, "\r\n")] = '\0';
    for (size_t i = 0; str[i]; i++)
        if (str[i] != '0' && str[i] != '1') {
            printf("Invalid symbol '%c'.\n", str[i]);
            return 1;
        }
    printf(S(str, 0, (int)strlen(str) - 1)
           ? "String BELONGS to the language of the CFG\n"
           : "String does NOT belong to the language of the CFG\n");
    return 0;
}
